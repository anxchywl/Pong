:root {
    --ink-strong: rgb(242, 247, 250);
    --ink: rgb(184, 198, 207);
    --ink-muted: rgb(118, 136, 148);
    --surface: rgba(14, 24, 31, 0.96);
    --surface-soft: rgba(25, 39, 48, 0.88);
    --surface-hover: rgba(34, 51, 62, 0.96);
    --line: rgba(157, 186, 200, 0.18);
    --line-strong: rgba(157, 213, 222, 0.52);
    --accent: rgb(103, 226, 211);
    --accent-strong: rgb(147, 248, 231);
    --accent-ink: rgb(7, 26, 29);
    --danger: rgb(255, 123, 132);
}

.game-ui {
    flex-grow: 1;
    color: var(--ink-strong);
    background-color: rgba(5, 12, 18, 0.22);
    overflow: hidden;
}

.screen-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 42px 58px 30px 58px;
    background-color: rgb(5, 12, 18);
}

.screen {
    flex-grow: 1;
    opacity: 1;
    transition-property: opacity, translate;
    transition-duration: 0.14s;
    translate: 0 0;
}

.is-hidden {
    display: none;
}

.top-bar,
.footer-bar,
.screen-header,
.main-content,
.detail-row,
.menu-button-row,
.tab-bar,
.setting-row,
.binding-row,
.confirmation-actions,
.debug-panel {
    flex-direction: row;
    align-items: center;
}

.theme-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.theme-overlay--scanlines {
    justify-content: space-between;
}

.theme-overlay__scanline {
    height: 1px;
    background-color: rgba(0, 0, 0, 0.52);
}

.theme-overlay__circuit-line {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.08);
}

.theme-overlay__circuit-line--vertical {
    width: 1px;
    height: 100%;
}

.theme-overlay__circuit-line--horizontal {
    width: 100%;
    height: 1px;
}


.top-bar {
    height: 54px;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.wordmark {
    color: var(--ink-strong);
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 7px;
}

.top-bar__meta,
.footer-bar__hint,
.selection-summary {
    color: var(--ink-muted);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

/* columns stretch rather than float, so the menu fills its height instead of
   leaving a band of dead space above and below */
.main-content {
    flex-grow: 1;
    align-items: stretch;
    padding: 32px 3% 24px 3%;
}

.main-content__navigation {
    flex-grow: 1;
    max-width: 620px;
    min-width: 420px;
    margin-right: 40px;
    justify-content: flex-start;
}

.nav-stack {
    flex-grow: 1;
    justify-content: center;
    max-height: 420px;
}

.eyebrow {
    color: var(--accent);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2.5px;
    margin-bottom: 10px;
}

.display-title {
    color: var(--ink-strong);
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: -1.5px;
    margin-bottom: 8px;
}

.lede,
.screen-description {
    color: var(--ink);
    font-size: 17px;
    margin-bottom: 28px;
}

.panel {
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 18px;
}

.panel-soft {
    background-color: rgba(10, 20, 27, 0.86);
    border-width: 1px;
    border-color: rgba(192, 219, 226, 0.14);
    border-radius: 12px;
}

.menu-button,
.back-button,
.tab-button,
.text-button,
.icon-button,
.selection-card,
.cosmetic-card {
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--surface-soft);
    color: var(--ink-strong);
    -unity-font-style: bold;
    transition-property: background-color, border-color, color, translate, opacity;
    transition-duration: 0.11s;
}

.menu-button {
    height: 46px;
    max-width: 430px;
    margin-bottom: 8px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 10px;
    font-size: 13px;
    letter-spacing: 1.2px;
    -unity-text-align: middle-left;
}

.menu-button:hover,
.menu-button:focus,
.back-button:hover,
.back-button:focus,
.tab-button:hover,
.tab-button:focus,
.text-button:hover,
.text-button:focus,
.icon-button:hover,
.icon-button:focus,
.selection-card:hover,
.selection-card:focus,
.cosmetic-card:hover,
.cosmetic-card:focus {
    background-color: var(--surface-hover);
    border-color: var(--line-strong);
    translate: 2px 0;
}

.menu-button:active,
.back-button:active,
.tab-button:active,
.text-button:active,
.icon-button:active,
.selection-card:active,
.cosmetic-card:active {
    translate: 0 1px;
    opacity: 0.84;
}

.menu-button:disabled,
.selection-card:disabled,
.cosmetic-card:disabled {
    opacity: 0.42;
    border-color: rgba(157, 186, 200, 0.1);
}

.menu-button--primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
}

.menu-button--primary:hover,
.menu-button--primary:focus {
    background-color: var(--accent-strong);
    border-color: var(--accent-strong);
}

.menu-button--danger {
    color: rgb(25, 10, 13);
    background-color: var(--danger);
    border-color: var(--danger);
}

.menu-button-row {
    max-width: 430px;
    margin-top: 5px;
}

.text-button {
    height: 34px;
    margin-right: 8px;
    padding-left: 2px;
    padding-right: 16px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    letter-spacing: 1.2px;
}

.text-button--danger {
    color: var(--danger);
}

/* sized by its contents rather than stretched to the column, so a short lineup leaves
   quiet background instead of a bordered void */
.match-preview {
    width: 39%;
    max-width: 490px;
    min-width: 350px;
    padding: 24px;
    align-self: flex-start;
}

.match-preview__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

/* four seat rows fill the card on their own; this only keeps the detail rows off them */
.match-preview__spacer {
    height: 12px;
}

.lineup {
    margin-top: 8px;
    margin-bottom: 4px;
}

.lineup-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    justify-content: space-between;
}

.lineup-row__seat {
    color: var(--ink-muted);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.lineup-row__occupant {
    color: var(--ink);
    font-size: 12px;
}

.lineup-row--vacant .lineup-row__occupant {
    color: var(--ink-muted);
}

/* roughly the court's own proportions: it reads as a court rather than as whatever
   height happened to be left over */
.match-preview__court {
    height: 196px;
    margin-top: 8px;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
    background-color: rgb(7, 18, 25);
}

.preview-paddle,
.preview-net,
.preview-ball {
    position: absolute;
    background-color: var(--accent);
}

.preview-paddle {
    width: 6px;
    height: 52px;
    top: 78px;
    border-radius: 3px;
}

.preview-paddle--left {
    left: 34px;
}

.preview-paddle--right {
    right: 34px;
    background-color: rgb(126, 157, 255);
}

.preview-net {
    width: 2px;
    height: 166px;
    left: 50%;
    top: 22px;
    opacity: 0.24;
}

.preview-ball {
    width: 12px;
    height: 12px;
    left: 63%;
    top: 36%;
    border-radius: 6px;
    background-color: var(--ink-strong);
}

.detail-row {
    height: 38px;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.detail-row__label {
    color: var(--ink-muted);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.detail-row__value {
    color: var(--ink-strong);
    font-size: 12px;
    -unity-font-style: bold;
}

/* a category rail beside one panel of content. Shared by settings and the customization
   workshop: only the selected category is on screen, so neither needs to scroll */
.workbench {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    padding: 8px 3% 8px 3%;
}

.category-rail {
    width: 208px;
    flex-shrink: 0;
    margin-right: 36px;
    padding-top: 4px;
}

.rail-button {
    height: 42px;
    margin-bottom: 6px;
    padding: 0 16px 0 16px;
    border-width: 0;
    border-left-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-muted);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    -unity-text-align: middle-left;
}

.rail-button:hover {
    color: var(--ink);
    background-color: var(--surface-soft);
}

/* the selected category is marked on the rail itself rather than by a moving highlight,
   so the eye can find where it is without animation */
.rail-button.is-selected {
    color: var(--ink-strong);
    border-color: var(--accent);
    background-color: var(--surface-soft);
}

.workbench__body {
    flex-grow: 1;
}

.settings-section {
    flex-grow: 1;
}

/* a workshop, not another settings page: categories to the left, the thing you are
   changing large in the middle, what you own to the right, actions along the bottom */
.workshop {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    padding: 4px 3% 0 3%;
}

.workshop__stage {
    flex-grow: 1;
    margin-right: 32px;
}

.workshop-preview {
    flex-shrink: 0;
}

/* the preview is the centre of the screen: it is the biggest thing here on purpose */
.workshop-preview__court {
    height: 232px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
    background-color: var(--surface);
    overflow: hidden;
}

.workshop-preview__hud {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    align-items: center;
}

.workshop-preview__score {
    color: var(--ink-strong);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.workshop-preview__caption {
    color: var(--ink-muted);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

.workshop__options {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    margin-top: 18px;
}

.workshop__collection {
    width: 296px;
    flex-shrink: 0;
    padding: 22px;
}

.collection__title {
    color: var(--ink-strong);
    font-size: 22px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.collection__description {
    color: var(--ink);
    font-size: 12px;
    margin-top: 6px;
    white-space: normal;
}

.collection__swatches {
    flex-direction: row;
    margin-top: 14px;
}

.collection__divider {
    height: 1px;
    margin: 18px 0 4px 0;
    background-color: var(--line);
}

.collection__note {
    color: var(--ink-muted);
    font-size: 10px;
    margin-top: 16px;
    white-space: normal;
}

/* actions sit on one line at the foot of the screen: reset and randomize are quiet,
   apply is the only thing that commits */
.workshop__actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 12px 3% 16px 3%;
}

.workshop__dirty {
    flex-grow: 1;
    color: var(--accent);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.menu-button--compact {
    width: 148px;
    height: 42px;
    margin-left: 10px;
    margin-bottom: 0;
}

/* deliberately not a .selection-card: those are the full-width mode cards, and inheriting
   their 380px minimum turned every swatch into a slab */
.option-card {
    width: 132px;
    height: 88px;
    margin: 0 10px 10px 0;
    padding: 12px;
    align-items: flex-start;
    justify-content: space-between;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 10px;
    background-color: var(--surface-soft);
    transition-property: background-color, border-color, translate;
    transition-duration: 0.11s;
}

.option-card:hover {
    border-color: var(--ink-muted);
    translate: 0 -2px;
}

.option-card.is-selected {
    border-color: var(--accent);
    background-color: var(--surface);
}

.option-card__title {
    color: var(--ink);
    font-size: 11px;
    -unity-font-style: bold;
}

/* laid out rather than absolute: the 48px collection swatches are too big for a card this
   size and were sitting under the title */
.option-card__swatches {
    flex-direction: row;
}

.option-card__swatches .cosmetic-card__swatch {
    width: 26px;
    height: 26px;
    margin-right: 6px;
    border-radius: 7px;
}

.option-card.is-selected .option-card__title {
    color: var(--ink-strong);
}

.option-card.is-locked {
    opacity: 0.4;
}

/* the players screen mirrors the court: left side on the left, right on the right,
   so the seat you configure is the paddle you will use */
.court-lineup {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    padding: 8px 3% 0 3%;
}

/* centred rather than top-aligned: four cards cannot fill this screen, so the slack is
   split evenly and reads as breathing room instead of content that fell to the top */
.court-lineup__side {
    flex-grow: 1;
    width: 50%;
    justify-content: center;
}

.court-lineup__divider {
    width: 1px;
    margin: 48px 32px 48px 32px;
    background-color: var(--line);
}

.seat-column {
    margin-top: 12px;
}

.seat-card {
    flex-grow: 1;
    margin-bottom: 12px;
    padding: 16px 18px 16px 18px;
    max-height: 132px;
    align-items: flex-start;
    justify-content: center;
}

.seat-card__role {
    color: var(--ink-muted);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
}

.seat-card__occupant {
    color: var(--ink-strong);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.seat-card__hint {
    color: var(--ink-muted);
    font-size: 11px;
}

.seat-card--vacant .seat-card__occupant {
    color: var(--ink-muted);
}

.input-hint {
    color: var(--ink-muted);
    font-size: 11px;
    margin-top: 18px;
}

.input-hint--center {
    -unity-text-align: middle-center;
}

.footer-bar {
    height: 38px;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.screen-header {
    min-height: 76px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.back-button {
    width: 74px;
    height: 34px;
    margin-right: 22px;
    border-radius: 9px;
    font-size: 10px;
    letter-spacing: 1px;
}

.screen-title {
    color: var(--ink-strong);
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: -0.5px;
}

.selection-summary {
    margin-left: auto;
}

.screen-description {
    margin-top: 24px;
    margin-bottom: 12px;
}

.screen-scroll,
.settings-scroll {
    flex-grow: 1;
    margin-top: 12px;
}

.card-grid,
.settings-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding-right: 12px;
    padding-bottom: 28px;
}

.selection-card {
    width: 47.5%;
    min-width: 380px;
    min-height: 170px;
    margin-right: 2.5%;
    margin-bottom: 22px;
    padding: 24px;
    border-radius: 16px;
    align-items: flex-start;
    -unity-text-align: upper-left;
    white-space: normal;
}

.selection-card.is-selected,
.cosmetic-card.is-selected,
.tab-button.is-selected {
    border-color: var(--accent);
    background-color: rgba(31, 62, 65, 0.94);
}

.selection-card__eyebrow {
    color: var(--accent);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
}

.selection-card__title,
.cosmetic-card__title {
    color: var(--ink-strong);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 7px;
}

.selection-card__description,
.cosmetic-card__description {
    color: var(--ink);
    font-size: 13px;
    white-space: normal;
}

.tab-bar {
    min-height: 62px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.tab-button {
    height: 34px;
    margin-right: 8px;
    padding-left: 15px;
    padding-right: 15px;
    border-radius: 17px;
    font-size: 10px;
    letter-spacing: 1px;
}

.cosmetic-card {
    width: 30.5%;
    min-width: 250px;
    min-height: 178px;
    margin-right: 2.5%;
    margin-bottom: 22px;
    padding: 20px;
    border-radius: 15px;
    align-items: flex-start;
    -unity-text-align: upper-left;
    white-space: normal;
}

.cosmetic-card__swatches {
    height: 48px;
    flex-direction: row;
    margin-bottom: 17px;
}

.theme-card .cosmetic-card__swatches {
    margin-top: 18px;
    margin-bottom: 0;
}

.cosmetic-card__swatch {
    width: 48px;
    height: 48px;
    margin-right: 8px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
}

.cosmetic-card__title {
    font-size: 18px;
}

.settings-grid {
    justify-content: space-between;
}

.settings-section {
    width: 49%;
    min-width: 470px;
    margin-bottom: 20px;
    padding: 22px 24px 12px 24px;
}

.settings-section--wide {
    width: 100%;
}

.settings-section__title {
    color: var(--accent);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 5px;
}

.settings-section__subtitle {
    color: var(--ink-muted);
    font-size: 12px;
    margin-bottom: 12px;
}

.setting-row,
.binding-row {
    min-height: 58px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.setting-copy {
    flex-grow: 1;
    min-width: 170px;
}

.setting-label,
.binding-row__action {
    color: var(--ink-strong);
    font-size: 13px;
    -unity-font-style: bold;
}

.setting-label--short {
    width: 120px;
}

.setting-description {
    color: var(--ink-muted);
    font-size: 10px;
    margin-top: 3px;
}

.setting-control {
    width: 170px;
    margin-left: 16px;
    margin-right: 12px;
}

.setting-value {
    width: 48px;
    color: var(--ink);
    font-size: 11px;
    -unity-text-align: middle-right;
}

.setting-control .unity-base-field__label,
.toggle-control .unity-base-field__label,
.dropdown-control .unity-base-field__label {
    display: none;
}

.setting-control .unity-base-slider__tracker {
    height: 4px;
    background-color: rgba(167, 193, 205, 0.18);
    border-width: 0;
}

.setting-control .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    background-color: var(--accent);
    border-color: var(--accent);
}

.toggle-control {
    margin-left: auto;
}

.toggle-control .unity-toggle__input {
    width: 38px;
    height: 22px;
    border-radius: 11px;
    border-color: var(--line-strong);
    background-color: rgba(82, 99, 109, 0.34);
}

.toggle-control:checked .unity-toggle__input {
    background-color: var(--accent);
    border-color: var(--accent);
}

.dropdown-control {
    width: 190px;
    margin-left: auto;
}

.dropdown-control .unity-base-field__input {
    min-height: 34px;
    border-radius: 8px;
    border-color: var(--line);
    background-color: var(--surface-soft);
    color: var(--ink-strong);
}

.status-pill,
.key-chip {
    color: var(--ink-muted);
    background-color: rgba(129, 151, 162, 0.1);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 7px;
    padding: 6px 9px 6px 9px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.is-disabled-row {
    opacity: 0.52;
}

.binding-row__action {
    width: 190px;
}

.key-chip {
    margin-right: 9px;
    color: var(--ink);
}

.credits-content {
    width: 64%;
    max-width: 760px;
    min-width: 520px;
    margin-top: 56px;
    padding: 44px;
}

.credits-mark {
    color: var(--ink-strong);
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 10px;
}

.credits-role {
    color: var(--accent);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.3px;
    margin-top: 12px;
}

.credits-copy {
    max-width: 600px;
    color: var(--ink);
    font-size: 16px;
    white-space: normal;
    margin-top: 28px;
}

.credits-divider {
    height: 1px;
    margin-top: 34px;
    background-color: var(--line);
}

/* the HUD lives in the margin the camera now leaves above the court, so it is never
   competing with the ball for the same pixels. It spans the screen and ignores picking, so
   its children can be placed against the frame rather than against the score's own height */
.hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud__bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 22px 40px 0 40px;
}

/* equal-weight end slots keep the score optically centred without absolute positioning */
.hud__slot {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
}

.hud__slot--end {
    justify-content: flex-end;
}

.hud__mode-label {
    color: var(--ink-muted);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2.5px;
}

/* padded rather than fixed-size, so a theme can put a frame around the score without
   having to know how tall its contents are */
.hud__score {
    flex-direction: row;
    align-items: flex-start;
    padding: 10px 24px 16px 24px;
}

.hud__score-side {
    width: 104px;
    align-items: center;
}

.hud__score-divider {
    width: 1px;
    height: 34px;
    margin: 6px 20px 0 20px;
    background-color: var(--line);
}

/* the score is the one thing a player looks for mid-rally: it gets the largest type
   on screen and nothing else competes at this size */
.hud__score-value {
    color: var(--ink-strong);
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud__score-caption {
    color: var(--ink-muted);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 2px;
}

/* one pip per point needed to win: how much match is left, without doing arithmetic */
.hud__pips {
    flex-direction: row;
    margin-top: 6px;
}

.hud__pip {
    width: 12px;
    height: 3px;
    margin: 0 2px 0 2px;
    background-color: var(--line);
}

.hud__pip--won {
    background-color: var(--accent);
}

.icon-button {
    width: 42px;
    height: 38px;
    border-radius: 11px;
    font-size: 12px;
    letter-spacing: 2px;
}

/* announcements belong on the court, where the player is already looking, rather than
   tucked under the score where they collided with the progress pips */
.hud__status {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 30%;
    color: var(--ink-muted);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.modal-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 9, 13, 0.74);
}

.modal-layer--top {
    background-color: rgba(3, 9, 13, 0.88);
}

.modal-card {
    width: 430px;
    padding: 32px;
    background-color: rgb(13, 24, 31);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 18px;
}

.modal-title {
    color: var(--ink-strong);
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 24px;
}

.modal-copy {
    color: var(--ink);
    font-size: 13px;
    margin-top: -13px;
    margin-bottom: 22px;
}

.pause-card .text-button {
    margin-top: 4px;
    align-self: flex-start;
}

.win-score {
    color: var(--accent);
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-top: -10px;
    margin-bottom: 28px;
    -unity-text-align: middle-center;
}

.confirmation-card {
    width: 470px;
}

.confirmation-actions {
    justify-content: flex-end;
}

.confirmation-actions .menu-button {
    width: 150px;
    margin-left: 10px;
    -unity-text-align: middle-center;
}

.debug-panel {
    position: absolute;
    right: 28px;
    bottom: 24px;
    padding: 7px 10px 7px 10px;
    background-color: rgba(7, 16, 22, 0.88);
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--line);
}

.debug-panel__text,
.debug-panel__badge {
    color: var(--ink);
    font-size: 9px;
    -unity-font-style: bold;
}

.debug-panel__badge {
    color: var(--accent);
    margin-left: 9px;
    letter-spacing: 1px;
}

.reduced-motion * {
    transition-duration: 0s;
}
